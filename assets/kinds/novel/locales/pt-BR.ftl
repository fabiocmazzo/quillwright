# O tipo Romance como o app o mostra. Veja en.ftl para o que é cada mensagem.

novel = Romance
novel-description = Capítulos, fichas de personagens e as regras do seu mundo

novel-research = Pesquisa
novel-research-hint = PDFs, imagens e notas — pressione + para adicionar.

novel-documents = Capítulos
novel-documents-one = capítulo
    .gender = masculine
novel-documents-count = { $count ->
    [one] { $count } capítulo
   *[other] { $count } capítulos
}
novel-documents-new = Novo capítulo
novel-documents-new-menu = Novo Capítulo
novel-documents-empty = Ainda não há capítulos — pressione + para começar um.
novel-documents-first = Escrever o primeiro capítulo

novel-sheets = Personagens
novel-sheets-one = personagem
    .gender = masculine
novel-sheets-count = { $count ->
    [one] { $count } personagem
   *[other] { $count } personagens
}
novel-sheets-new = Novo personagem
novel-sheets-new-menu = Novo Personagem
novel-sheets-empty = Ainda não há personagens — pressione + para adicionar um.
novel-sheets-first = Adicionar o primeiro personagem
novel-sheets-sent = { $count ->
    [one] { $count } ficha de personagem
   *[other] { $count } fichas de personagens
}

novel-ask-hint = Pergunte qualquer coisa, ou oriente os botões acima (“mais tensão, frases mais curtas”)

novel-action-rewrite = Reescrever a seleção
    .hint = Reescreve o trecho selecionado
novel-action-continue = Continuar a cena
    .hint = Escreve o que vem a seguir, no cursor
novel-action-alternatives = Três alternativas
    .hint = Três versões diferentes da seleção
novel-action-continuity = Verificar a continuidade
    .hint = Revisa este capítulo em relação ao cânone

novel-context-world-rules = regras do mundo
