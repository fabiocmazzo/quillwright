# 应用中显示的“小说”类型。各条消息的含义见 en.ftl。

novel = 小说
novel-description = 章节、人物设定和你的世界规则

novel-research = 资料
novel-research-hint = PDF、图片和笔记 — 按 + 添加。

novel-documents = 章节
novel-documents-one = 章节
    .gender = other
novel-documents-count = { $count } 章
novel-documents-new = 新建章节
novel-documents-new-menu = 新建章节
novel-documents-empty = 还没有章节 — 按 + 开始写一章。
novel-documents-first = 写第一章

novel-sheets = 人物
novel-sheets-one = 人物
    .gender = other
novel-sheets-count = { $count } 个人物
novel-sheets-new = 新建人物
novel-sheets-new-menu = 新建人物
novel-sheets-empty = 还没有人物 — 按 + 添加一个。
novel-sheets-first = 添加第一个人物
novel-sheets-sent = { $count } 份人物设定

novel-ask-hint = 随便问，或给上面的按钮补充要求（“更紧张，句子更短”）

novel-action-rewrite = 改写所选内容
    .hint = 改写所选的段落
novel-action-continue = 续写场景
    .hint = 在光标处写出接下来的内容
novel-action-alternatives = 三种写法
    .hint = 所选内容的三个不同版本
novel-action-continuity = 检查连贯性
    .hint = 对照设定检查本章

novel-context-world-rules = 世界规则
