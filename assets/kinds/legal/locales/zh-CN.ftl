# 应用中显示的“法律案件”类型。各条消息的含义见 ../../novel/locales/en.ftl。

legal = 法律案件
legal-description = 一个案件的各份文书，以及事实、时间线、当事人和证据

legal-research = 案卷
legal-research-hint = 法院卷宗、证据材料和其他 PDF — 按 + 添加。

legal-documents = 文书
legal-documents-one = 文书
    .gender = other
legal-documents-count = { $count } 份文书
legal-documents-new = 新建文书
legal-documents-new-menu = 新建文书
legal-documents-empty = 还没有文书 — 按 + 开始写一份。
legal-documents-first = 写第一份文书

legal-sheets = 当事人
legal-sheets-one = 当事人
    .gender = other
legal-sheets-count = { $count } 位当事人
legal-sheets-new = 新建当事人
legal-sheets-new-menu = 新建当事人
legal-sheets-empty = 还没有当事人 — 按 + 添加一位。
legal-sheets-first = 添加第一位当事人
legal-sheets-sent = { $count } 份当事人资料

legal-ask-hint = 随便问，或给上面的按钮补充要求（“更正式”“引用证据”）

legal-action-rewrite = 改写所选内容
    .hint = 改写所选的段落
legal-action-draft = 根据事实起草
    .hint = 根据事实和证据，在光标处起草文字
legal-action-check = 对照事实检查
    .hint = 将本文书与事实、时间线和证据进行比较
legal-action-questions = 给客户的问题
    .hint = 把仍不清楚的内容整理成给客户的问题

legal-context-facts = 事实
legal-context-timeline = 时间线
legal-context-evidence = 证据清单
legal-context-client-questions = 客户问题
